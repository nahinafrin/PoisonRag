"""Stage 6 - knowledge-anchored evidence arbitration (the answer generator).

Security invariant: retrieved text may ADD knowledge the model lacks, but can never
OVERRULE knowledge the model states it has. A corpus-poisoning attacker therefore
controls only questions the backbone cannot answer by itself, and there it still
needs >= 2 independent (non-coordinated) passages to be accepted as corroborated.

  1. Internal knowledge  k = LLM("concise text answering q, or 'I don't know'", <=50 words)
                         p = short answer extracted from k (UNKNOWN if k abstains)
  2. Isolated evidence   a_i = LLM(q, passage_i) for each surviving passage, one call
                         per passage, so no passage can steer the reading of another.
  3. Clustering          answers merged by normalised token containment / F1 >= 0.6.
                         Witness weight t_i = 1 - r_i (poison risk); a coordinated
                         group from the poison-consensus stage counts once.
  4. Decision
       p known                        -> answer p (with k as its justification)
       p unknown, cluster >= 2 witn.  -> corroborated external answer
       p unknown, one external claim  -> answer flagged "uncorroborated", but ABSTAIN if the
                                         poison stage saw poison for this query (R >= 0.5 or a drop)
       otherwise                      -> abstain ("sources do not support an answer")

Backbone: llama3.1:8b via Ollama, temperature 0. Calls: 2 + |passages| (<= 7).
"""
from __future__ import annotations

import re

from .state import RAGState

BACKBONE = "llama3.1:8b"
OLLAMA = "http://localhost:11434"

KNOWLEDGE_PROMPT = (
    "Generate a concise text that provides accurate and relevant information to answer the given "
    "question [{question}?] If the information is unclear or uncertain, explicitly state 'I don't know' "
    "to avoid any hallucinations. Please less than 50 words!")
EXTRACT_PROMPT = (
    "Using ONLY the text below, answer the question with ONE short phrase or single value, keeping "
    "all details the text gives (full dates, units, full names). If the text does not answer it or "
    "says it does not know, reply exactly \"UNKNOWN\".\n\nTEXT:\n{knowledge}\n\nQUESTION: {question}\n\nShort answer:")
PASSAGE_PROMPT = (
    "Answer the question using ONLY the document below. Reply with ONE short phrase or single value - "
    "no full sentences, no explanation. If the document does not contain the answer, reply exactly "
    "\"INSUFFICIENT\".\n\nDOCUMENT:\n{passage}\n\nQUESTION: {question}\n\nShort answer:")

_ABSTAIN = re.compile(r"\b(insufficient|unknown|don'?t know|do not know|not (sure|certain|specified|stated|"
                      r"mentioned|provided|available|in the (context|document|text))|no information|cannot "
                      r"(determine|tell|say)|unable to|unclear)\b", re.I)
_STRIP = re.compile(r"[^\w\s.\-]")
_ARTICLES = {"the", "a", "an", "of", "is", "are", "was", "were"}


class OllamaLLM:
    def __init__(self, model: str = BACKBONE, base_url: str = OLLAMA):
        from langchain_ollama import ChatOllama
        common = dict(model=model, base_url=base_url, temperature=0.0, seed=0, num_ctx=4096,
                      keep_alive="60m", client_kwargs={"timeout": 240})
        self.short = ChatOllama(num_predict=48, **common)
        self.long = ChatOllama(num_predict=160, **common)

    def ask(self, prompt: str, long: bool = False) -> str:
        out = (self.long if long else self.short).invoke(prompt)
        return (getattr(out, "content", str(out)) or "").strip()


def _first_line(s):
    s = re.sub(r"^\s*(short answer|answer)\s*:\s*", "", (s or "").strip().split("\n")[0], flags=re.I)
    return s.strip().strip('"').rstrip(".").strip()


def _norm(a):
    return " ".join(w for w in _STRIP.sub(" ", (a or "").lower()).split() if w not in _ARTICLES)


def is_unknown(a):
    return (not a) or bool(_ABSTAIN.search(a))


def same(a, b):
    na, nb = _norm(a), _norm(b)
    if not na or not nb:
        return False
    ta, tb = set(na.split()), set(nb.split())
    if na == nb or ta <= tb or tb <= ta:
        return True
    inter = len(ta & tb)
    if not inter:
        return False
    p, r = inter / len(tb), inter / len(ta)
    return 2 * p * r / (p + r) >= 0.6


def arbitrate(p: str, per: list[tuple[str, float, object]]) -> dict:
    """p: internal short answer; per: [(passage_answer, trust, group)]."""
    clusters = []
    p_known = not is_unknown(p)
    if p_known:
        clusters.append({"rep": p, "members": [("internal", 1.0, "internal", p)]})
    for i, (a, t, g) in enumerate(per):
        if is_unknown(a):
            continue
        for c in clusters:
            if same(a, c["rep"]):
                c["members"].append((f"passage{i}", t, f"g{g}", a))
                break
        else:
            clusters.append({"rep": a, "members": [(f"passage{i}", t, f"g{g}", a)]})
    for c in clusters:
        best = {}
        for src, w, g, _ in c["members"]:
            best[g] = max(best.get(g, 0.0), w)
        c["witnesses"] = len(best)
        c["weight"] = round(sum(best.values()), 4)
        c["has_internal"] = "internal" in best
        c["n_external"] = sum(1 for g in best if g != "internal")
        ext = [m for m in c["members"] if m[0] != "internal"]
        c["answer"] = ext[0][3] if ext else c["rep"]
    clusters.sort(key=lambda c: (c["witnesses"], c["weight"]), reverse=True)
    summary = [{k: c[k] for k in ("rep", "witnesses", "n_external", "weight", "has_internal")} for c in clusters]
    if p_known:
        ic = next(c for c in clusters if c["has_internal"])
        conflict = any(not c["has_internal"] for c in clusters)
        return {"decision": "internal_anchored" + ("_conflict" if conflict else ""), "answer": ic["answer"],
                "uses_internal": True, "clusters": summary}
    ext = [c for c in clusters if c["n_external"] >= 1]
    if ext and ext[0]["witnesses"] >= 2:
        return {"decision": "corroborated", "answer": ext[0]["answer"], "uses_internal": False, "clusters": summary}
    if ext:
        best = max(ext, key=lambda c: c["weight"])
        return {"decision": "uncorroborated", "answer": best["answer"], "uses_internal": False, "clusters": summary}
    return {"decision": "abstain", "answer": None, "uses_internal": False, "clusters": summary}


POISON_RISK_ABSTAIN = 0.5


def poison_seen(st: RAGState) -> bool:
    pc = st.meta.get("poison_consensus") or {}
    return bool(pc.get("dropped")) or st.risk >= POISON_RISK_ABSTAIN


def run(st: RAGState, llm: OllamaLLM) -> RAGState:
    if st.blocked:
        return st
    q = st.prompt
    knowledge = llm.ask(KNOWLEDGE_PROMPT.format(question=q), long=True)
    if not knowledge or "don't know" in knowledge.lower() or "do not know" in knowledge.lower():
        p = "UNKNOWN"
    else:
        p = _first_line(llm.ask(EXTRACT_PROMPT.format(knowledge=knowledge, question=q)))
    per = []
    for i, ps in enumerate(st.passages):
        try:
            a = _first_line(llm.ask(PASSAGE_PROMPT.format(passage=ps, question=q)))
        except Exception as e:                       # one bad call must not sink the row
            a = f"INSUFFICIENT ({type(e).__name__})"
        per.append((a, float(st.passage_trust.get(ps, 1.0)), st.passage_group.get(ps, 1000 + i)))
    d = arbitrate(p, per)
    st.meta["arbitration"] = {"internal_knowledge": knowledge, "parametric": p,
                              "per_passage": [a for a, _, _ in per], "trust": [t for _, t, _ in per],
                              "group": [g for _, _, g in per], "decision": d["decision"], "clusters": d["clusters"]}
    if d["answer"] is None:
        st.abstain("no trustworthy evidence and no internal knowledge")
        return st
    if d["decision"] == "uncorroborated" and poison_seen(st):
        # risk-adaptive abstention: a lone external claim is not accepted once the
        # poison-consensus stage has seen poison for this query (R >= 0.5 or a drop)
        st.meta["arbitration"]["decision"] = "abstain_uncorroborated_under_poison"
        st.abstain("single uncorroborated source while poison was detected")
        return st
    ans = d["answer"]
    if d["uses_internal"] and knowledge:
        ans = f"{ans}. {knowledge}"
    elif d["decision"] == "uncorroborated":
        st.meta["uncorroborated"] = True
    st.answer = ans
    return st
